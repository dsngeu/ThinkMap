{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/validate.mjs\"",
            "timeout": 10,
            "statusMessage": "Thinkmap: checking plan file"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/briefing.mjs\"",
            "timeout": 10,
            "statusMessage": "Thinkmap: plan briefing"
          }
        ]
      }
    ]
  }
}
